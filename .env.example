# Локальная разработка: скопировать в .env
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/energysphere
PORT=3000
KEYCLOAK_URL=https://keycloak-waw-ashinoff.waw0.amvera.tech
KEYCLOAK_REALM=platform
KEYCLOAK_CLIENT=web-desktop
# Необязательно: realm-роль, без которой в ЭнергоСферу не пускать (пусто = не проверять)
ACCESS_ROLE=
# Логины или e-mail суперадминов через запятую (видят всё, раздают права)
SUPER_ADMINS=
PLATFORM_ORIGIN=https://sue-system-2-ashinoff.waw0.amvera.tech
# Только для локальной разработки: вход без Keycloak под тестовым суперадмином
AUTH_DISABLED=false
# «Учёт ПУ» (Светлячок): ПУ по номеру договора в «Создание акта по ТУ».
# Ключ — тот же, что ES_SERVICE_KEY в «Учёт ПУ». Пусто — ПУ вводится вручную.
SVETLYACHOK_URL=
SVETLYACHOK_KEY=
