{
  "name": "energysphere",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ЭнергоСфера — единая рабочая платформа: анализ потребления, поиск потребителя, инструкция РИРУ, акты ТП",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev:db": "node --import tsx scripts/dev-db.ts",
    "dev:api": "node --env-file=.env --import tsx --watch apps/api/src/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && tsc -p tsconfig.api.json && vite build --config apps/web/vite.config.ts && vite build --config apps/tp-web/vite.config.ts",
    "start": "node dist/api/server.js",
    "test": "tsx --test tests/*.test.ts",
    "import:analyzer": "node scripts/import-analyzer.mjs",
    "import:tp": "node scripts/import-tp.mjs",
    "dev:tp-web": "vite --config apps/tp-web/vite.config.ts"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "diff": "^8.0.4",
    "docx-preview": "^0.3.7",
    "dompurify": "^3.4.17",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "fast-xml-parser": "^5.12.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.14",
    "jszip": "^3.10.2",
    "multer": "^2.5.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/diff": "^7.0.2",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^4.7.0",
    "embedded-postgres": "17.11.0-beta.19",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.5"
  }
}
