{
  "name": "energysphere",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ЭнергоСфера — единая рабочая платформа: анализ потребления, поиск потребителя, инструкция РИРУ, акты ТП",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "dev:db": "node --import tsx scripts/dev-db.ts",
    "dev:api": "node --env-file=.env --import tsx --watch apps/api/src/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && tsc -p tsconfig.api.json && vite build --config apps/web/vite.config.ts",
    "start": "node dist/api/server.js",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.14",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.7.0",
    "embedded-postgres": "17.11.0-beta.19",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.5"
  }
}
